HOST=127.0.0.1
PORT=7001
PUBLIC_URL=http://127.0.0.1:7001
VIDLINK_BASE_URL=https://vidlink.pro
PLAYBACK_ENVIRONMENT=standard
MULTI_LANG=0
PROXY_MODE=auto
# Blank uses the built-in range-aware media relay.
# Optional external VidLink-compatible media proxy origin.
MEDIA_PROXY_URL=
PROXY_TTL_SECONDS=21600
# Optional: at least 32 random characters to preserve relay links across restarts.
# PROXY_SECRET=
API_TIMEOUT_MS=25000
CACHE_SECONDS=300
# Optional public implementation key override: exactly 64 hex characters.
# VIDLINK_KEY_HEX=
